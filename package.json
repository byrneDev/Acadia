{
  "name": "acadia",
  "version": "0.5.0",
  "description": "Collect evidence. Connect ideas. Release understanding.",
  "author": {
    "name": "byrneDev",
    "email": "44509501+byrneDev@users.noreply.github.com",
    "url": "https://github.com/byrneDev"
  },
  "homepage": "https://github.com/byrneDev/Acadia",
  "repository": {
    "type": "git",
    "url": "https://github.com/byrneDev/Acadia.git"
  },
  "bugs": {
    "url": "https://github.com/byrneDev/Acadia/issues"
  },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "package:win": "node scripts/prepare-windows.cjs && npm run build && electron-builder --win nsis --x64",
    "package:linux": "node scripts/prepare-linux.cjs && npm run build && electron-builder --linux deb AppImage --x64 --publish never --config.extraMetadata.desktopName=acadia.desktop",
    "format": "prettier --write src tests scripts *.ts package.json",
    "notices": "node scripts/third-party-notices.cjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "adm-zip": "0.6.1",
    "docx": "^9.8.1",
    "dompurify": "^3.4.16",
    "jsdom": "^30.1.1",
    "mammoth": "^1.11.0",
    "markdown-it": "^15.0.2",
    "pdf-parse": "2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/adm-zip": "^0.5.7",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "12.12.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.48.0",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "dev.byrne.acadia",
    "productName": "Acadia",
    "directories": {
      "output": "release/v${version}"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "resources/branding/acadia-icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/branding/acadia-icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Acadia-${version}-linux-x64.${ext}",
      "executableName": "acadia",
      "category": "Office",
      "executableArgs": [],
      "synopsis": "Evidence-based research and analysis workspace",
      "description": "Collect local documents and web snapshots, organize evidence on a visual board, analyze with local or configured AI, and produce cited editable research reports.",
      "maintainer": "byrneDev <44509501+byrneDev@users.noreply.github.com>",
      "icon": "resources/branding/acadia-icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "acadia",
          "Keywords": "research;evidence;analysis;mindmap;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "libfontconfig1"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "docs/QUICK-START.md",
        "to": "QUICK-START.md"
      },
      {
        "from": "docs/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "docs/samples/Library-hours-sample.acadia",
        "to": "Library-hours-sample.acadia"
      },
      {
        "from": "docs/VALIDATION-v0.5.md",
        "to": "VALIDATION.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "docs/VALIDATION-v0.3.md",
        "to": "VALIDATION-v0.3.md"
      },
      {
        "from": "docs/VALIDATION-v0.4.md",
        "to": "VALIDATION-v0.4.md"
      },
      {
        "from": "docs/VALIDATION-v0.5.md",
        "to": "VALIDATION-v0.5.md"
      },
      {
        "from": "docs/LINUX.md",
        "to": "LINUX.md"
      },
      {
        "from": "docs/LOCAL-AI.md",
        "to": "LOCAL-AI.md"
      },
      {
        "from": "docs/RESEARCH-METHODS.md",
        "to": "RESEARCH-METHODS.md"
      },
      {
        "from": "docs/RESEARCH-TO-DELIVERY.md",
        "to": "RESEARCH-TO-DELIVERY.md"
      },
      {
        "from": "docs/POWER-BI.md",
        "to": "POWER-BI.md"
      },
      {
        "from": "docs/samples/Analytical-pedigree-sample.acadia",
        "to": "Analytical-pedigree-sample.acadia"
      },
      {
        "from": "docs/evaluations/v0.4-local-model.json",
        "to": "evaluations/v0.4-local-model.json"
      },
      {
        "from": "docs/evaluations/v0.4-item-summary-local-model.json",
        "to": "evaluations/v0.4-item-summary-local-model.json"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-linux-x64-gnu": "0.1.80",
    "@napi-rs/canvas-win32-x64-msvc": "0.1.80"
  }
}
